{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@aws-playground/server": ["../server/api/index.js"],
      "@aws-playground/server/types": ["../server/types.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
